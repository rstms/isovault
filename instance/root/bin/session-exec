#!/bin/bash
set -ue
user=$(awk -F: '/^[^:]*:x:1000:1000:.*/{print $1}' /etc/passwd)
pid=$(pgrep -u $user '^cinnamon$') 
#env="$(tr '\0' '\n' </proc/${pid}/environ | grep '^DBUS_SESSION_BUS_ADDRESS=')"
env="$(tr '\0' '\n' </proc/${pid}/environ)"
#tr '\0' '\n' </proc/${pid}/environ
if [ $# -gt 0 ]; then
    su -l $user <<<"$(echo $env) $@"
fi
