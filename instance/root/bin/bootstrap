#!/bin/bash

set -ue 

log=/root/bootstrap.log

if [ -f $log ]; then
    cp -a $log $(mktemp $log.XXXXXX)
    rm $log
fi

exec 3> >(while IFS= read -r line; do
    echo "$(date '+%Y-%m-%d %H:%M:%S') $line" | tee -a $log >>/dev/console 
done)

exec 4> >(while IFS= read -r line; do
    echo "$(date '+%Y-%m-%d %H:%M:%S') <err> $line" | tee -a $log >>/dev/console
done)

exec 5> >(while IFS= read -r line; do
    sed <<<$line 's/T/ /;s/+00:00/ <log>/' | tee -a $log >>/dev/console
done)

cleanup() {
    kill $pid
    exec 3>&-
    exec 4>&-
    exec 5>&-
    echo
}
trap cleanup EXIT

journalctl -f -o short-iso 1>&5 2>&5 &
pid=$!

/root/bin/configure 1>&3 2>&4
