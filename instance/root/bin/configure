#!/bin/bash

set -ue

echo "$(basename $0)" "$@"

menu_favorites="firefox-esr thunderbird org.xfce.mousepad ledger-live-desktop com.yubico.yubioath"
pinned_applications="firefox-esr thunderbird org.xfce.mousepad"
screensaver_timeout=3600

export user=$(awk -F: '/^[^:]*:x:1000:1000:.*/{print $1}' /etc/passwd)
export session_start_timeout=300
export PATH=/root/bin:$PATH
export tempdir=$(mktemp -d)
failed_command=
no_reset_session=

fail() {
    echo >&2 $0: "$@"
    exit 1
}

